{
  "name": "cattt-host",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "eval": "bun eval/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate && bun run scripts/embed-migrations.ts",
    "build": "bun build --compile --no-compile-autoload-dotenv src/main.ts src/ticket-workers/compute-worker.ts --outfile dist/cattt-host"
  },
  "dependencies": {
    "@peculiar/x509": "1.12.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "jose": "6.2.16",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
