# 复制成 .env 再填。.env 不进 git。
DATABASE_URL=postgres://maomao:maomao@localhost:5432/maomao
PORT=8787
HOST=127.0.0.1
LAN_HTTPS_HOST=0.0.0.0
LAN_HTTPS_PORT=8788
# CATTT_DATA_DIR 默认 server/.local；宿主设置为自己的持久数据目录

# 模型来源（默认来源；每个槽位还可用 CHAT_PROVIDER / EXTRACT_PROVIDER / ROUTER_PROVIDER / WORKER_PROVIDER 单独改）
# openai-compatible：本机 OpenAI 兼容服务（Ollama / LM Studio / llama.cpp server 等），也可指向自带 key 的兼容云服务
# deepseek：自带 key 的 DeepSeek 云 API，要填 MAOMAO_DEEPSEEK_API_KEY（带项目前缀，免得被 shell 里全局的 DEEPSEEK_API_KEY 盖掉）
# mock：假模型，不花钱，逐字吐固定回复，测试用；打开后所有槽位都用它
MODEL_PROVIDER=openai-compatible

# 本机服务地址要带 /v1：Ollama http://127.0.0.1:11434/v1，LM Studio http://127.0.0.1:1234/v1，llama.cpp http://127.0.0.1:8080/v1
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
# 各槽位默认共用的模型名（Ollama 先 ollama pull 这个名字）；槽位的 *_MODEL 优先
OPENAI_COMPAT_MODEL=
# 本机服务一般不用 key
MAOMAO_OPENAI_COMPAT_API_KEY=
# 关思考怎么传：reasoning_effort（Ollama 等）/ chat_template_kwargs（llama.cpp、vLLM 的 enable_thinking）/ none（不传）
OPENAI_COMPAT_THINKING_PARAM=reasoning_effort

MAOMAO_DEEPSEEK_API_KEY=

# 槽位模型名不填时：deepseek 来源用 deepseek-flash，兼容来源用 OPENAI_COMPAT_MODEL。
# 推理模型默认开思考，聊天要关掉，首字才快
# CHAT_MODEL=
CHAT_THINKING=disabled
# EXTRACT_MODEL=
EXTRACT_THINKING=disabled

# 相关记忆：复用现有提取模型扩词，本地排序，无新增供应商或正文索引副本
# local 仅用本地查找；许可/边界过滤始终生效
MEMORY_RECALL_MODE=hybrid
MEMORY_RECALL_TIMEOUT_MS=2500

# 事件措辞模型（只负责已获授权的约定）
# ROUTER_MODEL=
ROUTER_THINKING=disabled

# 托付执行者（思考开启）；例如本机模型不够用时只把它交给 DeepSeek：WORKER_PROVIDER=deepseek
# WORKER_PROVIDER=
# WORKER_MODEL=
WORKER_THINKING=enabled

# 第五段：development才允许开发token；staging/production只接受正式会话
APP_ENV=development
APPLE_CLIENT_ID=
SESSION_DAYS=7
# APNs没有配置时只保留PG待办，不切换假发送。p8用只读文件挂载。
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_FILE=
APNS_TOPIC=
# 全用途合计、UTC日、调用前保守预留；失败不退还
MODEL_DAILY_CALL_LIMIT=120
MODEL_DAILY_TOKEN_LIMIT=2000000
# 回退时关闭时钟、后台主动执行与新接单工具，仍可读/取消既有事项
AGENT_ENABLED=true
