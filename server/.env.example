# 复制成 .env 再填。.env 不进 git。
DATABASE_URL=postgres://maomao:maomao@localhost:5432/maomao
PORT=8787
HOST=127.0.0.1
LAN_HTTPS_HOST=0.0.0.0
LAN_HTTPS_PORT=8788
# CATTT_DATA_DIR 默认 server/.local；宿主设置为自己的持久数据目录

# deepseek：真模型，要填 MAOMAO_DEEPSEEK_API_KEY（带项目前缀，免得被 shell 里全局的 DEEPSEEK_API_KEY 盖掉）
# mock：假模型，不花钱，逐字吐固定回复，测试用
MODEL_PROVIDER=deepseek
MAOMAO_DEEPSEEK_API_KEY=

# DeepSeek V4.1 Flash。这个模型默认开思考，聊天要关掉，首字才快
CHAT_MODEL=deepseek-flash
CHAT_THINKING=disabled
EXTRACT_MODEL=deepseek-flash
EXTRACT_THINKING=disabled

# 相关记忆：复用现有提取模型扩词，本地排序，无新增供应商或正文索引副本
# local 仅用本地查找；许可/边界过滤始终生效
MEMORY_RECALL_MODE=hybrid
MEMORY_RECALL_TIMEOUT_MS=2500

# 事件措辞模型（只负责已获授权的约定）
ROUTER_MODEL=deepseek-flash
ROUTER_THINKING=disabled

# 托付执行者（思考开启）
WORKER_MODEL=deepseek-flash
WORKER_THINKING=enabled

# 第五段：development才允许开发token；staging/production只接受正式会话
APP_ENV=development
APPLE_CLIENT_ID=
SESSION_DAYS=7
# APNs没有配置时只保留PG待办，不切换假发送。p8用只读文件挂载。
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_FILE=
APNS_TOPIC=
# 全用途合计、UTC日、调用前保守预留；失败不退还
MODEL_DAILY_CALL_LIMIT=120
MODEL_DAILY_TOKEN_LIMIT=2000000
# 回退时关闭时钟、后台主动执行与新接单工具，仍可读/取消既有事项
AGENT_ENABLED=true
