{
  "name": "maomao-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@peculiar/x509": "1.12.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "jose": "^6.2.16",
    "pg-boss": "^12.38.1",
    "postgres": "^3.4.9",
    "qrcode-terminal": "0.12.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/qrcode-terminal": "0.12.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "eval:memory": "vitest run --silent=false --no-file-parallelism test/memory-eval.test.ts",
    "pair": "tsx scripts/pair.ts",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "check:model": "tsx scripts/check-model.ts",
    "model:setup": "tsx scripts/model-setup.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "create-dev-user": "tsx scripts/create-dev-user.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
